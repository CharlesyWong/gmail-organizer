# Copy this file to .env and adjust values. Never commit .env.

# Paths are relative to the repository root unless absolute.
GMAIL_CREDENTIALS_PATH=.secrets/credentials.json
GMAIL_TOKEN_PATH=.secrets/token.json

# Base Gmail search query used for every run.
GMAIL_QUERY=in:inbox -in:chats

# Bootstrap = first run (latest N messages).
# Incremental = later runs (only mail newer than the stored watermark).
GMAIL_BOOTSTRAP_LIMIT=100
GMAIL_INCREMENTAL_LIMIT=200
GMAIL_STATE_PATH=data/state.json

LOG_LEVEL=INFO

# Required only for the FastAPI endpoint (v1.2.0).
ORGANIZER_API_KEY=change-me
